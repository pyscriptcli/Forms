# ClickUp Integration Keys
# 1. Obtain Personal API Token from ClickUp: Settings -> Apps -> Generate API Token
CLICKUP_API_TOKEN=pk_your_clickup_token_here

# 2. Target ClickUp List ID (the numeric ID from your ClickUp List URL, e.g. https://app.clickup.com/12345/v/li/987654321 -> 987654321)
CLICKUP_LIST_ID=your_list_id_here

# Optional: Custom domain for public deployment (used to build revision links)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
